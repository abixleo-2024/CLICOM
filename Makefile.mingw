# Makefile.mingw
# CLICOM Phase 0 — MinGW Build (fallback when cmake is not on PATH)
#
# Usage (run from the clicom/ project root):
#   mingw32-make -f Makefile.mingw          # build all
#   mingw32-make -f Makefile.mingw test     # build + run all tests
#   mingw32-make -f Makefile.mingw clean    # clean build outputs
#
# This Makefile is a developer convenience for machines where CMake is not
# yet installed. The canonical build system is CMake (CMakeLists.txt).
# Install CMake from https://cmake.org/download/ and use scripts\build_windows.bat
# for the canonical workflow.
#
# Compiler: g++.exe used as C11 compiler (MinGW GCC 6.3.0)
#           g++ is used as the C compiler frontend with -x c to force
#           C compilation (gcc.exe is not separately in PATH on this MinGW install).
# Standard: -x c -std=c11
# Version header: generated by scripts/generate_version_header.py (Python 3)

CC      = g++.exe
CFLAGS  = -x c -std=c11 -Wall -Wextra -Wpedantic -Wno-unused-parameter \
          -DWIN32_LEAN_AND_MEAN \
          -Icommon/include

BUILD_DIR    = build/mingw-debug
GEN_INC      = $(BUILD_DIR)/include
VER_HEADER   = $(GEN_INC)/clip_version.h

CFLAGS += -I$(GEN_INC)

CLIENT_EXE    = $(BUILD_DIR)/clicom.exe
SERVER_EXE    = $(BUILD_DIR)/clicom-server.exe
TEST_VER_EXE  = $(BUILD_DIR)/test_version.exe

COMMON_SRCS   = common/src/clip_log.c common/src/clip_errors.c
CLIENT_SRCS   = client/src/main.c
SERVER_SRCS   = server/src/main.c
TEST_VER_SRCS = tests/unit/test_version.c

# ── Default target ───────────────────────────────────────────────────────
.PHONY: all test clean dirs version_header

all: dirs version_header $(CLIENT_EXE) $(SERVER_EXE) $(TEST_VER_EXE)
	@echo.
	@echo ============================================================
	@echo  CLICOM Phase 0 Build Complete  (MinGW fallback)
	@echo  Client : $(CLIENT_EXE)
	@echo  Server : $(SERVER_EXE)
	@echo  Test   : $(TEST_VER_EXE)
	@echo ============================================================

dirs:
	if not exist "$(BUILD_DIR)\include" mkdir "$(BUILD_DIR)\include"

version_header: $(VER_HEADER)

$(VER_HEADER):
	python scripts/generate_version_header.py $(GEN_INC)

$(CLIENT_EXE): $(COMMON_SRCS) $(CLIENT_SRCS) $(VER_HEADER)
	$(CC) $(CFLAGS) -o $@ $(COMMON_SRCS) $(CLIENT_SRCS)

$(SERVER_EXE): $(COMMON_SRCS) $(SERVER_SRCS) $(VER_HEADER)
	$(CC) $(CFLAGS) -o $@ $(COMMON_SRCS) $(SERVER_SRCS)

$(TEST_VER_EXE): $(COMMON_SRCS) $(TEST_VER_SRCS) $(VER_HEADER)
	$(CC) $(CFLAGS) -o $@ $(COMMON_SRCS) $(TEST_VER_SRCS)

# ── Test target ───────────────────────────────────────────────────────────
test: all
	@echo.
	@echo ============================================================
	@echo  Running Phase 0 Tests
	@echo ============================================================
	@echo.
	@echo [1/5] Unit::Version
	$(TEST_VER_EXE)
	@echo.
	@echo [2/5] Startup::Client::Version
	$(CLIENT_EXE) --version
	@echo.
	@echo [3/5] Startup::Client::SelfTest
	$(CLIENT_EXE) --test
	@echo.
	@echo [4/5] Startup::Server::Version
	$(SERVER_EXE) --version
	@echo.
	@echo [5/5] Startup::Server::SelfTest
	$(SERVER_EXE) --test
	@echo.
	@echo ============================================================
	@echo  All Phase 0 tests complete.
	@echo ============================================================

# ── Clean ─────────────────────────────────────────────────────────────────
clean:
	if exist "$(BUILD_DIR)" rmdir /s /q "$(BUILD_DIR)"
	@echo Cleaned $(BUILD_DIR)
