# Build output
build/
cmake-build-*/
out/

# Generated files (do not commit — regenerated by CMake at configure time)
**/include/clip_version.h

# CMake internal files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# IDE / editor files
.vs/
*.suo
*.user
*.aps
.idea/
*.code-workspace
.vscode/settings.json

# Compiled binaries
*.exe
*.pdb
*.ilk
*.dll
*.so
*.dylib
*.lib
*.a

# Object files
*.o
*.obj

# SQLite database (runtime artifact, not source)
*.db
*.db-shm
*.db-wal

# Log files (runtime artifact)
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Packaging artifacts
packaging/windows/*.msi
packaging/windows/*.wixobj
packaging/windows/*.wixpdb

# Allow client distribution package binaries
!dist_client/*.dll
!dist_client/**/*.dll
!dist_client/certs/ca.crt

# Credentials and scratch
*.cred
build-release/
out.txt
reproduce_*.py
__pycache__/
*.pyc
# Private TLS keys and credentials
*.key
*.pem
*.p12
*.pfx

# Python cache files
__pycache__/
*.py[cod]