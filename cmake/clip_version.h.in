/*
 * clip_version.h  —  AUTO-GENERATED BY CMAKE. DO NOT EDIT MANUALLY.
 *
 * CLICOM - CLI Communication System
 *
 * IMPORTANT: Software version and protocol version are intentionally separate.
 *
 *   Software version  : tracks binary releases (semantic versioning).
 *   Protocol version  : governs wire compatibility between clients and servers.
 *                       CLIPv1.0 is the first stable protocol revision.
 *
 * These two versions advance independently. Never conflate them.
 * Protocol changes are documented in docs/PROTOCOL_CHANGELOG.md.
 */

#ifndef CLIP_VERSION_H
#define CLIP_VERSION_H

/* ── Software Version ───────────────────────────────────────────────────── */
#define CLICOM_VERSION_MAJOR    @PROJECT_VERSION_MAJOR@
#define CLICOM_VERSION_MINOR    @PROJECT_VERSION_MINOR@
#define CLICOM_VERSION_PATCH    @PROJECT_VERSION_PATCH@
#define CLICOM_VERSION_STRING   "@PROJECT_VERSION@"

/* ── Protocol Version (CLIPv1) ──────────────────────────────────────────── */
/* A breaking wire change increments CLIP_PROTOCOL_VERSION_MAJOR.            */
/* Backward-compatible additions increment CLIP_PROTOCOL_VERSION_MINOR.      */
#define CLIP_PROTOCOL_VERSION_MAJOR   @CLIP_PROTOCOL_VERSION_MAJOR@
#define CLIP_PROTOCOL_VERSION_MINOR   @CLIP_PROTOCOL_VERSION_MINOR@
#define CLIP_PROTOCOL_VERSION_STRING  "@CLIP_PROTOCOL_VERSION_MAJOR@.@CLIP_PROTOCOL_VERSION_MINOR@"

/* Protocol wire magic: ASCII "CLIP" = 0x43 0x4C 0x49 0x50                  */
#define CLIP_PROTOCOL_MAGIC  0x434C4950u

/* ── Build Metadata ─────────────────────────────────────────────────────── */
#define CLICOM_BUILD_TIMESTAMP   "@CLICOM_BUILD_TIMESTAMP@"
#define CLICOM_TARGET_PLATFORM   "@CLICOM_TARGET_PLATFORM@"

#endif /* CLIP_VERSION_H */
